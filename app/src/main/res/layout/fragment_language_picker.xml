<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LanguagePickerFragment"
    android:background="@drawable/bg_gradient">

    <RelativeLayout
        android:id="@+id/appLanguageTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/appLanguageBackIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:src="@drawable/leftarrow" />

        <TextView
            android:id="@+id/appLanguageTitleTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/appLanguageBackIcon"
            android:fontFamily="@font/roboto_regular"
            android:text="App Language"
            android:textColor="#81d8d0"
            android:textSize="22sp"
            android:layout_marginStart="30dp"
            android:textStyle="bold"
            android:paddingBottom="5dp"/>

    </RelativeLayout>

    <View
        android:id="@+id/appLanguagePageLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:alpha="0.3"
        android:background="#81d8d0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languageRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:padding="12dp"
        tools:listitem="@layout/item_language"/>

</LinearLayout>