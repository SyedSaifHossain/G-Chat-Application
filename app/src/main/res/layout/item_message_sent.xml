<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:layout_marginStart="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:gravity="end"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sentVideoContainer"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/sentMessageVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/sentVideoPlayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                app:tint="@android:color/white" />

        </FrameLayout>

        <RelativeLayout
            android:id="@+id/qroupChatSendTextBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_sent"
            android:gravity="end|bottom"
            android:padding="8dp"
            android:minWidth="115dp">

            <LinearLayout
                android:id="@+id/sentMessageVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="3dp"
                android:layout_toStartOf="@+id/sentMessageTime"
                android:gravity="start|top"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/sentVoicePlayButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/speakeron"/>

                <!-- Sent voice duration (next to play button) -->
                <TextView
                    android:id="@+id/sentVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="3s"
                    android:textColor="#2C2C2C"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Sent message text -->
            <com.vanniktech.emoji.EmojiTextView
                android:id="@+id/sentMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:gravity="start|top"
                android:lineSpacingExtra="2dp"
                android:lineSpacingMultiplier="1.2"
                android:maxWidth="200dp"
                android:maxLength="1000"
                android:maxLines="5"
                android:paddingTop="5dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"
                android:visibility="visible"
                android:text="This is text message"
                android:textColor="#000" />
            <!-- Sent message time (next to text) -->
            <TextView
                android:id="@+id/sentMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="15dp"
                android:layout_toEndOf="@+id/sentMessageText"
                android:gravity="bottom|end"
                android:text="10:00 am"
                android:textColor="#2C2C2C"
                android:textSize="10sp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/sentMessageImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/profileSend"
            android:adjustViewBounds="true"
            android:maxWidth="240dp"
            android:maxHeight="300dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profileimage"
            android:layout_gravity="end|bottom"
            android:scaleType="centerCrop"
            android:layout_marginStart="3dp"
            app:shapeAppearanceOverlay="@style/RoundedImageViewStyle" />



    </LinearLayout>

    <LinearLayout
        android:id="@+id/sentMessageFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_sent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_alignParentTop="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/document" />

        <TextView
            android:id="@+id/sentFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:text="File"
            android:textColor="#000000"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>