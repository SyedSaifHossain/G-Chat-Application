<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="start">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/receivedSenderAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="bottom"
        android:src="@drawable/profilenew"
        app:shapeAppearanceOverlay="@style/RoundedImageViewStyle" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/receivedSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送者"
            android:textColor="#81d8d0"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"
            android:visibility="visible" />

        <FrameLayout
            android:id="@+id/receivedVideoContainer"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_toEndOf="@+id/receivedSenderAvatar"
            android:visibility="gone"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/receivedMessageVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/receivedVideoPlayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/white" />
        </FrameLayout>


        <LinearLayout
            android:id="@+id/receivedMessageFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_received"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/document" />

            <TextView
                android:id="@+id/receivedFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:text="文件"
                android:textColor="#000"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bubbleGroupChatReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_received"
            android:maxWidth="240dp"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/receivedMessageVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="5dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/receivedVoicePlayButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/speakeron" />

                <TextView
                    android:id="@+id/receivedVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0s"
                    android:textColor="#2C2C2C"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/receivedMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is receive message"
                android:textColor="#000"
                android:paddingHorizontal="8dp"
                android:maxWidth="180dp"
                app:layout_constrainedWidth="true"/>

            <TextView
                android:id="@+id/receivedMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00AM"
                android:textColor="#2C2C2C"
                android:textSize="10sp"
                android:layout_marginStart="3dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="5dp"
                android:paddingTop="15dp"
                android:layout_gravity="bottom|end"/>
        </LinearLayout>

        <!-- Other message components (Image, Video, etc.) -->
        <ImageView
            android:id="@+id/receivedMessageImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:adjustViewBounds="true"
            android:maxWidth="240dp"
            android:maxHeight="300dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </LinearLayout>


</LinearLayout>